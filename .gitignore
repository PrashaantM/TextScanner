# Node. Matches both the root install (Capacitor/ML Kit tooling) and
# test/node_modules (playwright-core, for the benchmark harness). test/ used to
# symlink a borrowed Playwright install from an unrelated local project, which
# made the harness unrunnable from a fresh clone; it now has a real
# devDependency of its own. Both package-lock.json files ARE committed for
# reproducible installs - not listed here.
node_modules

# Capacitor (iOS native shell - the only native platform this project
# targets, iPhone being the only test device). www/ is a disposable,
# regenerated copy of index.html/style.css/js/ (see
# scripts/sync-web-assets.sh) - the real source of truth stays at the repo
# root, unchanged, for the existing GitHub Pages deployment. ios/ IS
# committed (standard Capacitor practice - it has its own nested .gitignore
# for Pods/, DerivedData/, xcuserdata, and copied web assets, scaffolded by
# `cap add ios`). Podfile/Podfile.lock are committed as part of that -
# Podfile.lock pins exact pod versions for reproducible installs.
/www/

# Manual OCR output test/score-manual.js expects you to paste engine output
# into (e.g. from an on-device ML Kit run) - private test data, not source.
/test/manual-output/

# legacy-opencv-scripts/ is a couple of plain Python exercises, no framework
# or virtualenv involved - just their bytecode cache.
__pycache__/
*.py[cod]

# OS
.DS_Store
